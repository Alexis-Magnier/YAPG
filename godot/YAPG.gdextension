[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../YAPG/target/debug/libyapg.so"
linux.release.x86_64 =   "res://../YAPG/target/release/libyapg.so"
windows.debug.x86_64 =   "res://../YAPG/target/debug/yapg.dll"
windows.release.x86_64 = "res://../YAPG/target/release/yapg.dll"
macos.debug =            "res://../YAPG/target/debug/libyapg.dylib"
macos.release =          "res://../YAPG/target/release/libyapg.dylib"
macos.debug.arm64 =      "res://../YAPG/target/debug/libyapg.dylib"
macos.release.arm64 =    "res://../YAPG/target/release/libyapg.dylib"
